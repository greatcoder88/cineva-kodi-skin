<?xml version='1.0' encoding='utf-8'?>
<addons>
  <addon id="skin.cineva" version="0.8.2" name="CINÉVA" provider-name="CINÉVA Project; based on Nimbus by Ivar Brandt">
    <requires>
      <import addon="xbmc.gui" version="5.18.0" />
      <import addon="script.cineva.nimbus" version="0.1.1" />
    </requires>
    <extension point="xbmc.gui.skin" debugging="false">
      <res width="1920" height="1440" aspect="4:3" default="false" folder="xml" />
      <res width="1920" height="1280" aspect="3:2" default="false" folder="xml" />
      <res width="1920" height="1200" aspect="16:10" default="false" folder="xml" />
      <res width="2040" height="1080" aspect="17:9" default="false" folder="xml" />
      <res width="1920" height="1080" aspect="16:9" default="true" folder="xml" />
      <res width="2560" height="1080" aspect="21:9" default="false" folder="xml" />
      <res width="2338" height="1080" aspect="19.5:9" default="false" folder="xml" />
      <res width="2160" height="1080" aspect="18:9" default="false" folder="xml" />
    </extension>
    <extension point="xbmc.addon.metadata">
      <platform>all</platform>
      <license>GPL-2.0-only; artwork CC BY-SA 4.0</license>
      <assets>
        <icon>resources/icon.png</icon>
        <fanart>resources/fanart.png</fanart>
      </assets>
      <summary lang="en_GB">CINÉVA cinematic Kodi skin, based on Nimbus</summary>
      <summary lang="en_NZ">Nimbus skin by Ivar Brandt</summary>
      <summary lang="en_US">Nimbus skin by Ivar Brandt</summary>
      <description lang="en_GB">A remote-first cinematic Kodi skin based on Nimbus by Ivar Brandt.</description>
      <description lang="en_NZ">Nimbus Skin</description>
      <description lang="en_US">Nimbus Skin</description>
    </extension>
  </addon>
  <addon id="script.cineva.nimbus" name="CINÉVA Nimbus Bridge" version="0.1.1" provider-name="CINÉVA Project; based on Nimbus Helper by Ivar Brandt">
    <requires>
      <import addon="xbmc.python" version="3.0.0" />
    </requires>
    <extension point="xbmc.python.library" library="resources/lib/default.py" />
    <extension point="xbmc.service" library="resources/lib/service.py" start="startup" />
    <extension point="xbmc.addon.metadata">
      <news />
      <platform>all</platform>
      <license>GPL-2.0-only</license>
      <forum />
      <source />
      <description lang="en_GB">Local widget, menu and search bridge for CINÉVA.</description>
      <description lang="en_NZ">Nimbus Helper for the Nimbus Skin.</description>
      <description lang="en_US">Nimbus Helper for the Nimbus Skin.</description>
    </extension>
  </addon>
  <addon id="skin.frame" version="0.1.72" name="Frame" provider-name="Ivar Brandt">
    <requires>
      <import addon="xbmc.gui" version="5.17.0" />
      <import addon="script.frame.nimbus" version="0.0.60" />
    </requires>
    <extension point="xbmc.gui.skin" debugging="false">
      <res width="1920" height="1440" aspect="4:3" default="false" folder="xml" />
      <res width="1920" height="1280" aspect="3:2" default="false" folder="xml" />
      <res width="1920" height="1200" aspect="16:10" default="false" folder="xml" />
      <res width="2040" height="1080" aspect="17:9" default="false" folder="xml" />
      <res width="1920" height="1080" aspect="16:9" default="true" folder="xml" />
      <res width="2560" height="1080" aspect="21:9" default="false" folder="xml" />
      <res width="2338" height="1080" aspect="19.5:9" default="false" folder="xml" />
      <res width="2160" height="1080" aspect="18:9" default="false" folder="xml" />
    </extension>
    <extension point="xbmc.addon.metadata">
      <platform>all</platform>
      <license>CC BY-SA 4.0, GNU GENERAL PUBLIC LICENSE Version 2.0</license>
      <assets>
        <icon>resources/icon.png</icon>
        <fanart>resources/fanart.png</fanart>
      </assets>
      <summary lang="en_GB">Nimbus skin by Ivar Brandt</summary>
      <summary lang="en_NZ">Nimbus skin by Ivar Brandt</summary>
      <summary lang="en_US">Nimbus skin by Ivar Brandt</summary>
      <description lang="en_GB">Nimbus Skin</description>
      <description lang="en_NZ">Nimbus Skin</description>
      <description lang="en_US">Nimbus Skin</description>
    </extension>
  </addon>
  <addon id="script.frame.nimbus" name="Frame Nimbus Helper" version="0.0.60" provider-name="Ivar Brandt">
    <requires>
      <import addon="xbmc.python" version="3.0.0" />
      <import addon="script.module.requests" version="2.19.1" />
      <import addon="script.module.pil" version="1.1.7" />
    </requires>
    <extension point="xbmc.python.library" library="resources/lib/default.py" />
    <extension point="xbmc.service" library="resources/lib/service.py" start="startup" />
    <extension point="xbmc.addon.metadata">
      <news />
      <platform>all</platform>
      <license>GPL-2.0-only</license>
      <forum />
      <source />
      <assets>
        <icon>resources/media/icon.png</icon>
        <fanart>resources/media/fanart.jpg</fanart>
      </assets>
      <description lang="en_GB">Nimbus Helper for the Nimbus Skin.</description>
      <description lang="en_NZ">Nimbus Helper for the Nimbus Skin.</description>
      <description lang="en_US">Nimbus Helper for the Nimbus Skin.</description>
    </extension>
    <extension point="xbmc.python.pluginsource" library="resources/lib/playback_tracks.py">
      <provides>executable</provides>
    </extension>
  </addon>
</addons>