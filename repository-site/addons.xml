<?xml version='1.0' encoding='utf-8'?>
<addons>
  <addon id="skin.cineva" name="CINÉVA" version="0.5.3" provider-name="OpenAI">
    <requires>
      <import addon="xbmc.gui" version="5.18.0" />
      <import addon="script.skinshortcuts" version="3.0.0" />
      <import addon="script.cineva.widgets" version="0.1.3" />
    </requires>
    <extension point="xbmc.gui.skin" debugging="false">
      <res width="1920" height="1080" aspect="1.78" default="true" folder="xml" />
    </extension>
    <extension point="xbmc.addon.metadata">
      <summary lang="en_GB">CINÉVA cinematic skin</summary>
      <description lang="en_GB">A lightweight cinematic Kodi skin focused on video add-ons, poster shelves and remote-first navigation.</description>
      <platform>all</platform>
      <license>GPL-2.0-or-later</license>
      <assets>
        <icon>resources/icon.png</icon>
        <fanart>resources/fanart.png</fanart>
      </assets>
    </extension>
  </addon>
  <addon id="script.cineva.widgets" name="CINÉVA Widget Manager" version="0.1.3" provider-name="CINÉVA">
    <requires>
      <import addon="xbmc.python" version="3.0.0" />
      <import addon="xbmc.gui" version="5.18.0" />
    </requires>
    <extension point="xbmc.python.script" library="default.py">
      <provides>executable</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
      <summary lang="en_GB">CINÉVA widget source picker</summary>
      <description lang="en_GB">Configure per-screen video widget slots by browsing installed video add-ons.</description>
      <platform>all</platform>
      <license>GPL-2.0-or-later</license>
    </extension>
  </addon>
</addons>