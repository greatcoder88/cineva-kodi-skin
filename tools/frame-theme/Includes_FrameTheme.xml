          <visible>Integer.IsGreater(Container($PARAM[id]).NumItems,0)</visible>
        </control>
        <control type="image">
          <left>32</left>
          <top>80</top>
          <width>476</width>
          <height>1</height>
          <texture colordiffuse="frame_selection">colors/white.png</texture>
          <visible>Integer.IsGreater(Container($PARAM[id]).NumItems,0)</visible>
        </control>
        <control type="list" id="$PARAM[id]">
          <left>24</left>
          <top>88</top>
          <width>492</width>
          <height>224</height>
          <orientation>vertical</orientation>
          <scrolltime>100</scrolltime>
          <onup>$PARAM[id]</onup>
          <ondown>$PARAM[id]</ondown>
          <onback>ClearProperty(FrameTrackPicker)</onback>
          <onback>$PARAM[button]</onback>
          <onleft>ClearProperty(FrameTrackPicker)</onleft>
          <onleft>$PARAM[button]</onleft>
          <onright>ClearProperty(FrameTrackPicker)</onright>
          <onright>$PARAM[button]</onright>
          <onclick>RunPlugin(plugin://script.frame.nimbus/?kind=$PARAM[kind]&amp;select=$INFO[Container($PARAM[id]).ListItem.Property(FrameTrackIndex)])</onclick>
          <itemlayout width="492" height="56">
            <include content="FramePlaybackTrackRow">
              <param name="id" value="$PARAM[id]" />
              <param name="kind" value="$PARAM[kind]" />
            </include>
          </itemlayout>
          <focusedlayout width="492" height="56">
            <include content="FramePlaybackTrackRow">
              <param name="id" value="$PARAM[id]" />
              <param name="kind" value="$PARAM[kind]" />
              <param name="focused" value="true" />
            </include>
          </focusedlayout>
          <content target="video">plugin://script.frame.nimbus/?kind=$PARAM[kind]</content>
        </control>
      </control>
    </definition>
  </include>
