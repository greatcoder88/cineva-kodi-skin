<?xml version="1.0" encoding="UTF-8"?>
<includes>
  <include name="FrameDetailsActionItems">
    <itemlayout width="370" height="75">
      <control type="label">
        <left>22</left>
        <width>310</width>
        <height>66</height>
        <aligny>center</aligny>
        <font>FrameTVLabel</font>
        <textcolor>grey</textcolor>
        <label>$INFO[ListItem.Label]</label>
      </control>
    </itemlayout>
    <focusedlayout width="370" height="75">
      <control type="image">
        <width>328</width>
        <height>64</height>
        <texture border="24" colordiffuse="button_focus">masks/focus-long.png</texture>
        <visible>Control.HasFocus(20000)</visible>
      </control>
      <control type="label">
        <left>22</left>
        <width>302</width>
        <height>64</height>
        <aligny>center</aligny>
        <font>FrameTVLabel</font>
        <textcolor>focused_text</textcolor>
        <label>$INFO[ListItem.Label]</label>
        <visible>Control.HasFocus(20000)</visible>
      </control>
      <control type="label">
        <left>22</left>
        <width>302</width>
        <height>64</height>
        <aligny>center</aligny>
        <font>FrameTVLabel</font>
        <textcolor>unfocused_text</textcolor>
        <label>$INFO[ListItem.Label]</label>
        <visible>!Control.HasFocus(20000)</visible>
      </control>
    </focusedlayout>
  </include>
  <variable name="FrameCardArt">
    <value condition="!String.IsEmpty(ListItem.Art(landscape))">$INFO[ListItem.Art(landscape)]</value>
    <value condition="!String.IsEmpty(ListItem.Art(fanart))">$INFO[ListItem.Art(fanart)]</value>
    <value>$INFO[ListItem.Art(poster)]</value>
  </variable>
  <include name="FrameLandscapeCard">
    <param name="focused">false</param>
    <definition>
      <control type="group">
        <width>306</width>
        <height>172</height>
        <control type="image">
          <texture diffuse="masks/flixscape-widget.png" colordiffuse="primary_content_panel_bg">colors/white.png</texture>
        </control>
        <control type="image">
          <texture diffuse="masks/flixscape-widget.png" background="true">$VAR[FrameCardArt]</texture>
          <aspectratio scalediffuse="false">scale</aspectratio>
        </control>
        <control type="image">
          <top>94</top>
          <height>78</height>
          <width>306</width>
          <texture>overlays/overlayfade-fs-widget.png</texture>
        </control>
        <control type="label">
          <left>14</left>
          <top>119</top>
          <width>278</width>
          <height>42</height>
          <font>FrameTab</font>
          <textcolor>unfocused_text</textcolor>
          <label>$INFO[ListItem.Label]</label>
          <scroll>$PARAM[focused] + Control.HasFocus($PARAM[list_id])</scroll>
        </control>
        <control type="progress">
          <left>12</left>
          <top>161</top>
          <width>282</width>
          <height>5</height>
          <texturebg colordiffuse="osd_grey">osd/ProgressBack.png</texturebg>
          <midtexture colordiffuse="red">osd/Progress.png</midtexture>
          <info>ListItem.PercentPlayed</info>
          <visible>ListItem.IsResumable</visible>
        </control>
        <control type="image">
          <texture border="15" infill="false" colordiffuse="unfocused_text">masks/flixscape-border-widget.png</texture>
          <visible>$PARAM[focused] + Control.HasFocus($PARAM[list_id])</visible>
        </control>
      </control>
    </definition>
  </include>
  <include name="FrameSectionHeader">
    <definition>
      <control type="group">
        <depth>DepthBars</depth>
        <control type="image">
          <width>100%</width>
          <height>68</height>
          <texture colordiffuse="background">colors/white.png</texture>
        </control>
        <control type="label">
          <left>58</left>
          <top>5</top>
          <width>850</width>
          <height>62</height>
          <aligny>center</aligny>
          <font>font36_title</font>
          <textcolor>unfocused_text</textcolor>
          <label>$PARAM[title]</label>
        </control>
      </control>
    </definition>
  </include>
  <include name="FrameSideMenuPanel">
    <control type="image" id="8985">
      <width>465</width>
      <height>1080</height>
      <texture colordiffuse="F2141414">colors/white.png</texture>
      <visible>Control.HasFocus(9000) | ControlGroup(700).HasFocus</visible>
    </control>
  </include>
  <include name="FrameSideMenuItems">
    <itemlayout width="420" height="70">
      <control type="label">
        <left>22</left>
        <width>365</width>
        <height>63</height>
        <aligny>center</aligny>
        <font>FrameTVLabel</font>
        <textcolor>grey</textcolor>
        <label>$INFO[ListItem.Label]</label>
      </control>
    </itemlayout>
    <focusedlayout width="420" height="70">
      <control type="image">
        <width>391</width>
        <height>63</height>
        <texture border="23" colordiffuse="button_focus2">masks/focus-long.png</texture>
      </control>
      <control type="label">
        <left>22</left>
        <width>365</width>
        <height>63</height>
        <aligny>center</aligny>
        <font>FrameTVLabel</font>
        <textcolor>unfocused_text</textcolor>
        <label>$INFO[ListItem.Label]</label>
      </control>
    </focusedlayout>
  </include>
  <include name="FrameHomeFeature">
    <control type="group" id="8980">
      <left>64</left>
      <top>110</top>
      <width>1792</width>
      <height>656</height>
      <visible>$EXP[FrameFeatureVisible]</visible>
      <control type="image">
        <left>-64</left>
        <top>-110</top>
        <width>1920</width>
        <height>1080</height>
        <texture colordiffuse="background">colors/white.png</texture>
      </control>
      <control type="image">
        <visible>!$EXP[FrameFeatureHasFanart]</visible>
        <width>1792</width>
        <height>656</height>
        <texture diffuse="masks/giant-landscape.png" colordiffuse="primary_content_panel_bg">colors/white.png</texture>
      </control>
      <control type="image" id="8983">
        <width>1792</width>
        <height>656</height>
        <texture diffuse="masks/giant-landscape.png" background="true">$VAR[FrameFeatureArt]</texture>
        <aspectratio align="right" aligny="center" scalediffuse="false">scale</aspectratio>
        <visible>$EXP[FrameFeatureHasFanart]</visible>
        <fadetime>120</fadetime>
      </control>
      <control type="image">
        <width>1792</width>
        <height>656</height>
        <texture>frame/feature-scrim.png</texture>
        <visible>$EXP[FrameFeatureHasFanart]</visible>
      </control>
      <control type="group">
        <left>42</left>
        <top>258</top>
        <control type="image">
          <top>16</top>
          <width>630</width>
          <height>142</height>
          <aspectratio align="left" aligny="bottom">keep</aspectratio>
          <texture background="true">$VAR[FrameFeatureLogo]</texture>
          <visible>$EXP[FrameFeatureHasLogo]</visible>
        </control>
        <control type="textbox">
          <width>1040</width>
          <height>148</height>
          <font>FrameHeroTitle</font>
          <aligny>bottom</aligny>
          <textcolor>unfocused_text</textcolor>
          <shadowcolor>C8000000</shadowcolor>
          <label>$VAR[FrameFeatureTitle]</label>
          <visible>!$EXP[FrameFeatureHasLogo]</visible>
        </control>
        <control type="label">
          <top>157</top>
          <width>720</width>
          <height>39</height>
          <font>FrameTVLabel</font>
          <textcolor>unfocused_text</textcolor>
          <shadowcolor>C8000000</shadowcolor>
          <label>$VAR[FrameFeatureYear]$VAR[FrameFeatureGenre]</label>
        </control>
        <control type="textbox">
          <top>199</top>
          <width>925</width>
          <height>120</height>
          <font>FrameBody</font>
          <textcolor>unfocused_text</textcolor>
          <shadowcolor>C8000000</shadowcolor>
          <label>$VAR[FrameFeaturePlot]</label>
        </control>
        <control type="group">
          <top>328</top>
          <width>1100</width>
          <height>50</height>
          <visible>!Skin.HasSetting(Disable.AutoInfoRatings)</visible>
          <control type="label" id="8984">
            <width>390</width>
            <height>40</height>
            <font>FrameTab</font>
            <textcolor>unfocused_text</textcolor>
            <label>$VAR[FrameFeatureRating]</label>
            <visible>String.IsEmpty(Skin.String(valid_api_key)) | !ControlGroup(2000).HasFocus</visible>
          </control>
          <control type="group">
            <visible>ControlGroup(2000).HasFocus</visible>
            <include condition="!String.IsEmpty(Skin.String(valid_api_key))" content="HorizontalRatings" />
          </control>
        </control>
      </control>
    </control>
  </include>
</includes>
