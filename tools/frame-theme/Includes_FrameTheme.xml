  <include name="FrameResumeProgress">
    <definition>
      <control type="group">
        <left>$PARAM[left]</left>
        <top>$PARAM[top]</top>
        <width>$PARAM[width]</width>
        <height>24</height>
        <visible>ListItem.IsResumable + !String.IsEmpty(ListItem.PercentPlayed)</visible>
        <control type="image">
          <width>$PARAM[width]</width>
          <height>24</height>
          <texture border="8" colordiffuse="EC161B23">masks/focus-long.png</texture>
        </control>
        <control type="progress">
          <left>7</left>
          <top>10</top>
          <width>$PARAM[bar]</width>
          <height>4</height>
          <texturebg colordiffuse="osd_grey">osd/ProgressBack.png</texturebg>
          <midtexture colordiffuse="frame_track_accent">osd/Progress.png</midtexture>
          <info>ListItem.PercentPlayed</info>
        </control>
        <control type="label">
          <left>$PARAM[badge]</left>
          <right>7</right>
          <height>24</height>
          <align>right</align>
          <aligny>center</aligny>
          <font>FrameProgress</font>
          <textcolor>unfocused_text</textcolor>
          <label>$INFO[ListItem.PercentPlayed,,%]</label>
        </control>
      </control>
    </definition>
  </include>
