<?xml version="1.0" encoding="UTF-8"?>
<includes>
  <include name="FrameTopBar">
    <control type="image">
      <width>1920</width>
      <height>104</height>
      <texture colordiffuse="background">colors/white.png</texture>
    </control>
    <control type="label">
      <left>64</left>
      <top>25</top>
      <width>154</width>
      <height>50</height>
      <font>font36_title</font>
      <aligny>center</aligny>
      <textcolor>red</textcolor>
      <label>FRAME</label>
    </control>
  </include>
  <include name="FrameTopMenuItems">
    <itemlayout width="157" height="66">
      <control type="label">
        <left>2</left>
        <width>153</width>
        <height>60</height>
        <font>FrameTVLabel</font>
        <align>center</align>
        <aligny>center</aligny>
        <textcolor>grey</textcolor>
        <label>$INFO[ListItem.Label]</label>
      </control>
    </itemlayout>
    <focusedlayout width="157" height="66">
      <control type="image">
        <left>6</left>
        <top>6</top>
        <width>145</width>
        <height>50</height>
        <texture border="25" colordiffuse="button_focus2">masks/focus.png</texture>
        <visible>Control.HasFocus(9000)</visible>
      </control>
      <control type="label">
        <left>2</left>
        <width>153</width>
        <height>60</height>
        <font>FrameTVLabel</font>
        <align>center</align>
        <aligny>center</aligny>
        <textcolor>unfocused_text</textcolor>
        <label>$INFO[ListItem.Label]</label>
      </control>
    </focusedlayout>
  </include>
  <include name="FrameHomeFeature">
    <control type="group" id="8980">
      <left>64</left>
      <top>110</top>
      <width>1792</width>
      <height>656</height>
      <visible>$EXP[FrameFeatureVisible]</visible>
      <control type="image">
        <width>1792</width>
        <height>656</height>
        <texture diffuse="masks/giant-landscape.png" colordiffuse="FFD0D0D0" background="true" fallback="special://skin/resources/fallback.jpg">$VAR[FrameFeatureArt]</texture>
        <aspectratio align="right" aligny="center" scalediffuse="false">scale</aspectratio>
        <fadetime>120</fadetime>
      </control>
      <control type="image">
        <width>1792</width>
        <height>656</height>
        <texture diffuse="masks/giant-landscape.png" colordiffuse="38000000">colors/white.png</texture>
      </control>
      <control type="group">
        <left>42</left>
        <top>234</top>
        <control type="textbox">
          <width>1040</width>
          <height>160</height>
          <font>FrameHeroTitle</font>
          <aligny>bottom</aligny>
          <textcolor>unfocused_text</textcolor>
          <shadowcolor>C8000000</shadowcolor>
          <label>$VAR[FrameFeatureTitle]</label>
        </control>
        <control type="label">
          <top>173</top>
          <width>720</width>
          <height>39</height>
          <font>FrameTVLabel</font>
          <textcolor>unfocused_text</textcolor>
          <shadowcolor>C8000000</shadowcolor>
          <label>$VAR[FrameFeatureYear]$VAR[FrameFeatureGenre]</label>
        </control>
        <control type="textbox">
          <top>221</top>
          <width>925</width>
          <height>140</height>
          <font>font14</font>
          <textcolor>unfocused_text</textcolor>
          <shadowcolor>C8000000</shadowcolor>
          <label>$VAR[FrameFeaturePlot]</label>
        </control>
      </control>
    </control>
  </include>
</includes>
