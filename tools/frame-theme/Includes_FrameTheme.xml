<?xml version='1.0' encoding='UTF-8'?>
<includes>
  <include name="FrameDetailsActionItems">
    <itemlayout width="370" height="75">
      <control type="label">
        <left>22</left>
        <width>310</width>
        <height>66</height>
        <aligny>center</aligny>
        <font>FrameTVLabel</font>
        <textcolor>grey</textcolor>
        <label>$INFO[ListItem.Label]</label>
      </control>
    </itemlayout>
    <focusedlayout width="370" height="75">
      <control type="image">
        <width>328</width>
        <height>64</height>
        <texture border="24" colordiffuse="button_focus">masks/focus-long.png</texture>
        <visible>Control.HasFocus(20000)</visible>
      </control>
      <control type="label">
        <left>22</left>
        <width>302</width>
        <height>64</height>
        <aligny>center</aligny>
        <font>FrameTVLabel</font>
        <textcolor>focused_text</textcolor>
        <label>$INFO[ListItem.Label]</label>
        <visible>Control.HasFocus(20000)</visible>
      </control>
      <control type="label">
        <left>22</left>
        <width>302</width>
        <height>64</height>
        <aligny>center</aligny>
        <font>FrameTVLabel</font>
        <textcolor>unfocused_text</textcolor>
        <label>$INFO[ListItem.Label]</label>
        <visible>!Control.HasFocus(20000)</visible>
      </control>
    </focusedlayout>
  </include>
  <variable name="FrameCardArt">
    <value condition="!String.IsEmpty(ListItem.Art(landscape))">$INFO[ListItem.Art(landscape)]</value>
    <value condition="!String.IsEmpty(ListItem.Art(fanart))">$INFO[ListItem.Art(fanart)]</value>
  </variable>
  <include name="FrameLandscapeCard">
    <param name="focused">false</param>
    <definition>
      <control type="group">
        <width>420</width>
        <height>268</height>
        <control type="image">
          <width>420</width>
          <height>236</height>
          <aspectratio scalediffuse="false">scale</aspectratio>
          <texture diffuse="masks/flixscape-widget.png" background="true" fallback="frame/landscape-empty.png">$VAR[FrameCardArt]</texture>
        </control>
        <control type="label">
          <left>3</left>
          <top>243</top>
          <width>414</width>
          <height>32</height>
          <aligny>center</aligny>
          <font>FrameTVLabel</font>
          <textcolor>unfocused_text</textcolor>
          <label>$INFO[ListItem.Label]</label>
        </control>
        <include content="FrameResumeProgress">
          <param name="top" value="204" />
          <param name="left" value="10" />
          <param name="width" value="400" />
          <param name="bar" value="332" />
          <param name="badge" value="345" />
        </include>
        <include content="FrameCardFocusBorder">
          <param name="width" value="420" />
          <param name="height" value="236" />
          <param name="mask" value="masks/flixscape-border-widget.png" />
          <param name="focused" value="$PARAM[focused]" />
          <param name="list_id" value="$PARAM[list_id]" />
        </include>
      </control>
    </definition>
  </include>
  <include name="FramePosterCard">
    <param name="focused">false</param>
    <definition>
      <control type="group">
        <width>276</width>
        <height>409</height>
        <control type="image">
          <texture diffuse="masks/poster-big.png" colordiffuse="primary_content_panel_bg">colors/white.png</texture>
        </control>
        <control type="image">
          <texture diffuse="masks/poster-big.png" background="true">$INFO[ListItem.Art(poster)]</texture>
          <aspectratio scalediffuse="false">scale</aspectratio>
        </control>
        <control type="textbox">
          <left>12</left>
          <top>236</top>
          <width>252</width>
          <height>96</height>
          <font>FrameTab</font>
          <textcolor>unfocused_text</textcolor>
          <label>$INFO[ListItem.Label]</label>
          <visible>String.IsEmpty(ListItem.Art(poster))</visible>
        </control>
        <include content="FrameResumeProgress">
          <param name="top" value="379" />
          <param name="left" value="8" />
          <param name="width" value="260" />
          <param name="bar" value="197" />
          <param name="badge" value="209" />
        </include>
        <include content="FrameCardFocusBorder">
          <param name="width" value="276" />
          <param name="height" value="409" />
          <param name="mask" value="masks/poster-big-border.png" />
          <param name="focused" value="$PARAM[focused]" />
          <param name="list_id" value="$PARAM[list_id]" />
        </include>
      </control>
    </definition>
  </include>
  <include name="FrameSectionHeader">
    <definition>
      <control type="group">
        <depth>DepthBars</depth>
        <control type="image">
          <width>100%</width>
          <height>68</height>
          <texture colordiffuse="background">colors/white.png</texture>
        </control>
        <control type="label">
          <left>58</left>
          <top>5</top>
          <width>850</width>
          <height>62</height>
          <aligny>center</aligny>
          <font>font36_title</font>
          <textcolor>unfocused_text</textcolor>
          <label>$PARAM[title]</label>
        </control>
      </control>
    </definition>
  </include>
  <include name="FrameSideMenuPanel">
    <control type="image" id="8985">
      <width>465</width>
      <height>1080</height>
      <texture colordiffuse="dialog_bg3">colors/white.png</texture>
      <visible>Control.HasFocus(9000) | ControlGroup(700).HasFocus</visible>
    </control>
  </include>
  <include name="FrameSideMenuItems">
    <itemlayout width="420" height="70">
      <control type="label">
        <left>22</left>
        <width>365</width>
        <height>63</height>
        <aligny>center</aligny>
        <font>FrameTVLabel</font>
        <textcolor>grey</textcolor>
        <label>$INFO[ListItem.Label]</label>
      </control>
    </itemlayout>
    <focusedlayout width="420" height="70">
      <control type="image">
        <width>391</width>
        <height>63</height>
        <texture border="23" colordiffuse="button_focus2">masks/focus-long.png</texture>
      </control>
      <control type="label">
        <left>22</left>
        <width>365</width>
        <height>63</height>
        <aligny>center</aligny>
        <font>FrameTVLabel</font>
        <textcolor>unfocused_text</textcolor>
        <label>$INFO[ListItem.Label]</label>
      </control>
    </focusedlayout>
  </include>
  <include name="FrameHomeFeature">
    <control type="group" id="8980">
      <left>0</left>
      <top>0</top>
      <width>1920</width>
      <height>612</height>
      <visible>$EXP[FrameFeatureVisible]</visible>
      <control type="image" id="8983">
        <width>1350</width>
        <height>612</height>
        <texture diffuse="frame/feature-mask.png" background="true">$VAR[FrameFeatureArt]</texture>
        <aspectratio align="right" aligny="center" scalediffuse="false">scale</aspectratio>
        <visible>$EXP[FrameFeatureHasFanart]</visible>
        <fadetime>80</fadetime>
        <left>570</left>
      </control>
      <control type="group">
        <left>76</left>
        <top>47</top>
        <control type="image">
          <top>2</top>
          <width>660</width>
          <height>154</height>
          <aspectratio align="left" aligny="bottom">keep</aspectratio>
          <texture background="true">$VAR[FrameFeatureLogo]</texture>
          <visible>$EXP[FrameFeatureHasLogo]</visible>
        </control>
        <control type="textbox">
          <width>920</width>
          <height>168</height>
          <font>FrameHeroTitle</font>
          <aligny>bottom</aligny>
          <textcolor>unfocused_text</textcolor>
          <shadowcolor>C8000000</shadowcolor>
          <label>$VAR[FrameFeatureTitle]</label>
          <visible>!$EXP[FrameFeatureHasLogo]</visible>
        </control>
        <control type="label">
          <top>174</top>
          <width>795</width>
          <height>42</height>
          <font>FrameTVLabel</font>
          <textcolor>grey</textcolor>
          <shadowcolor>C8000000</shadowcolor>
          <label>$VAR[FrameFeatureYear]$VAR[FrameFeatureGenre]$VAR[FrameFeatureRuntime]</label>
        </control>
        <control type="textbox">
          <top>223</top>
          <width>750</width>
          <height>113</height>
          <font>FrameBody</font>
          <textcolor>unfocused_text</textcolor>
          <shadowcolor>C8000000</shadowcolor>
          <label>$VAR[FrameFeaturePlot]</label>
        </control>
        <control type="group">
          <top>351</top>
          <width>1100</width>
          <height>44</height>
          <visible>!Skin.HasSetting(Disable.AutoInfoRatings)</visible>
          <control type="label" id="8984">
            <width>760</width>
            <height>40</height>
            <font>FrameTab</font>
            <textcolor>unfocused_text</textcolor>
            <label>$VAR[FrameFeatureRating]$VAR[FrameFeatureTomatometer]</label>
            <visible>String.IsEmpty(Skin.String(valid_api_key)) | !ControlGroup(2000).HasFocus | !$EXP[FrameRatingCurrent]</visible>
          </control>
          <control type="group">
            <visible>ControlGroup(2000).HasFocus + $EXP[FrameRatingCurrent]</visible>
            <include condition="!String.IsEmpty(Skin.String(valid_api_key))" content="HorizontalRatings" />
          </control>
        </control>
        <width>820</width>
        <height>413</height>
      </control>
    </control>
  </include>
  <include name="FrameResumeProgress">
    <definition>
      <control type="group">
        <left>$PARAM[left]</left>
        <top>$PARAM[top]</top>
        <width>$PARAM[width]</width>
        <height>24</height>
        <visible>ListItem.IsResumable + !String.IsEmpty(ListItem.PercentPlayed)</visible>
        <control type="image">
          <width>$PARAM[width]</width>
          <height>24</height>
          <texture border="8" colordiffuse="EC161B23">masks/focus-long.png</texture>
        </control>
        <control type="progress">
          <left>7</left>
          <top>10</top>
          <width>$PARAM[bar]</width>
          <height>4</height>
          <texturebg colordiffuse="osd_grey">osd/ProgressBack.png</texturebg>
          <midtexture colordiffuse="frame_track_accent">osd/Progress.png</midtexture>
          <info>ListItem.PercentPlayed</info>
        </control>
        <control type="label">
          <left>$PARAM[badge]</left>
          <right>7</right>
          <height>24</height>
          <align>right</align>
          <aligny>center</aligny>
          <font>FrameProgress</font>
          <textcolor>unfocused_text</textcolor>
          <label>$INFO[ListItem.PercentPlayed,,%]</label>
        </control>
      </control>
    </definition>
  </include>
  <include name="FramePlaybackTrackRow">
    <param name="focused">false</param>
    <definition>
      <control type="image">
        <left>0</left>
        <width>492</width>
        <height>62</height>
        <texture border="22" colordiffuse="frame_track_focus">masks/focus-long.png</texture>
        <visible>[$PARAM[focused] + Control.HasFocus($PARAM[id])] | String.IsEqual(Window(VideoOSD).Property(FrameActiveTrack.$PARAM[kind]),ListItem.Property(FrameTrackIndex))</visible>
        <top>4</top>
      </control>
      <control type="image">
        <left>4</left>
        <top>18</top>
        <width>3</width>
        <height>34</height>
        <visible>$PARAM[focused] + Control.HasFocus($PARAM[id])</visible>
        <texture colordiffuse="$VAR[FrameAccent]">colors/white.png</texture>
      </control>
      <control type="label">
        <left>20</left>
        <width>320</width>
        <height>70</height>
        <aligny>center</aligny>
        <font>FrameTVLabel</font>
        <textcolor>unfocused_text</textcolor>
        <label>$INFO[ListItem.Label]</label>
        <scroll>$PARAM[focused] + Control.HasFocus($PARAM[id])</scroll>
        <top>0</top>
      </control>
      <control type="label">
        <left>447</left>
        <width>36</width>
        <height>70</height>
        <aligny>center</aligny>
        <font>FrameTVLabel</font>
        <textcolor>frame_track_accent</textcolor>
        <label>✓</label>
        <visible>String.IsEqual(Window(VideoOSD).Property(FrameActiveTrack.$PARAM[kind]),ListItem.Property(FrameTrackIndex))</visible>
        <top>0</top>
        <align>center</align>
      </control>
      <control type="label">
        <left>348</left>
        <width>81</width>
        <height>70</height>
        <align>right</align>
        <aligny>center</aligny>
        <font>FrameProgress</font>
        <textcolor>grey</textcolor>
        <label>$INFO[ListItem.Label2]</label>
      </control>
    </definition>
  </include>
  <include name="FramePlaybackTracks">
    <definition>
      <control type="group">
        <right>$PARAM[right]</right>
        <bottom>279</bottom>
        <width>377</width>
        <height>307</height>
        <visible>[$PARAM[available]] + [Control.HasFocus($PARAM[button]) | Control.HasFocus($PARAM[id]) | String.IsEqual(Window(VideoOSD).Property(FrameTrackPicker),$PARAM[kind])]</visible>
        <control type="label">
          <left>32</left>
          <top>24</top>
          <width>476</width>
          <height>44</height>
          <aligny>center</aligny>
          <font>FramePanelTitle</font>
          <textcolor>unfocused_text</textcolor>
          <label>$PARAM[title]</label>
          <visible>Integer.IsGreater(Container($PARAM[id]).NumItems,0)</visible>
        </control>
        <control type="image">
          <left>32</left>
          <top>80</top>
          <width>476</width>
          <height>1</height>
          <texture colordiffuse="frame_selection">colors/white.png</texture>
          <visible>Integer.IsGreater(Container($PARAM[id]).NumItems,0)</visible>
        </control>
        <control type="list" id="$PARAM[id]">
          <left>24</left>
          <top>88</top>
          <width>492</width>
          <height>224</height>
          <orientation>vertical</orientation>
          <scrolltime>100</scrolltime>
          <onup>$PARAM[id]</onup>
          <ondown>$PARAM[id]</ondown>
          <onback>ClearProperty(FrameTrackPicker)</onback>
          <onback>$PARAM[button]</onback>
          <onleft>ClearProperty(FrameTrackPicker)</onleft>
          <onleft>$PARAM[button]</onleft>
          <onright>ClearProperty(FrameTrackPicker)</onright>
          <onright>$PARAM[button]</onright>
          <onclick>RunPlugin(plugin://script.frame.nimbus/?kind=$PARAM[kind]&amp;select=$INFO[Container($PARAM[id]).ListItem.Property(FrameTrackIndex)])</onclick>
          <itemlayout width="492" height="56">
            <include content="FramePlaybackTrackRow">
              <param name="id" value="$PARAM[id]" />
              <param name="kind" value="$PARAM[kind]" />
            </include>
          </itemlayout>
          <focusedlayout width="492" height="56">
            <include content="FramePlaybackTrackRow">
              <param name="id" value="$PARAM[id]" />
              <param name="kind" value="$PARAM[kind]" />
              <param name="focused" value="true" />
            </include>
          </focusedlayout>
          <content target="video">plugin://script.frame.nimbus/?kind=$PARAM[kind]</content>
        </control>
      </control>
    </definition>
  </include>
  <variable name="FrameAccent">
    <value condition="!String.IsEmpty(Skin.String(Frame.Accent))">$INFO[Skin.String(Frame.Accent)]</value>
    <value>FF72EBC5</value>
  </variable>
  <variable name="FrameAccentLabel">
    <value condition="!String.IsEmpty(Skin.String(Frame.AccentLabel))">$INFO[Skin.String(Frame.AccentLabel)]</value>
    <value>Mint</value>
  </variable>
  <variable name="FrameCardAccent">
    <value condition="Skin.HasSetting(Frame.AdaptiveAccent) + !String.IsEmpty(Window(Home).Property(Frame.ArtAccent)) + String.IsEqual(Window(Home).Property(Frame.ArtAccentPoster),ListItem.Art(poster))">$INFO[Window(Home).Property(Frame.ArtAccent)]</value>
    <value>$VAR[FrameAccent]</value>
  </variable>
  <include name="FrameCardFocusBorder">
    <definition>
      <control type="image">
        <width>$PARAM[width]</width>
        <height>$PARAM[height]</height>
        <visible>$PARAM[focused] + Control.HasFocus($PARAM[list_id])</visible>
        <texture colordiffuse="$VAR[FrameCardAccent]" border="16" infill="false">$PARAM[mask]</texture>
      </control>
    </definition>
  </include>
</includes>