  <include name="FramePlaybackTracks">
    <definition>
      <control type="group">
        <right>$PARAM[right]</right>
        <bottom>321</bottom>
        <width>377</width>
        <height>307</height>
        <visible>[$PARAM[available]] + [Control.HasFocus($PARAM[button]) | Control.HasFocus($PARAM[id]) | String.IsEqual(Window(VideoOSD).Property(FrameTrackPicker),$PARAM[kind])]</visible>
        <control type="label">
          <left>32</left>
          <top>24</top>
          <width>476</width>
          <height>44</height>
          <aligny>center</aligny>
          <font>FramePanelTitle</font>
